{
  "name": "vikas-manjunath-portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "Vikas Manjunath: proof-of-work portfolio. Next.js static export.",
  "scripts": {
    "dev": "next dev -p 4300",
    "build": "next build --webpack",
    "start": "npx serve out -l 4300",
    "typecheck": "tsc --noEmit",
    "pdfs": "node scripts/make-pdfs.mjs",
    "og": "node scripts/og/make-og.mjs",
    "test:parity": "node scripts/parity/clock.parity.mts && node scripts/parity/akaar.parity.mts && node scripts/parity/finos.parity.mts",
    "test:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "test:lh": "node scripts/lh-budget.mjs",
    "test": "npm run test:parity && npm run test:links && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "serve": "^14.2.8",
    "typescript": "^5"
  }
}
